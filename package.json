{
  "name": "shazlo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/vitest.xml"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "16.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.39.0",
    "jsdom": "26.1.0",
    "mongodb-memory-server-core": "10.4.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
