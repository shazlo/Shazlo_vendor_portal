# Copy to .env (git-ignored) for local runs outside docker-compose.
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://shazlo:change-me@localhost:5432/identity
REDIS_URL=redis://localhost:6379/0

# Origins allowed to call the API with credentials (the Shazlo-One shell), comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh-token cookie. Browsers accept Secure cookies on http://localhost, so this can stay true;
# set it to false only if your browser refuses them (for example Safari).
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Leave unset locally. In production use the shared parent domain, e.g. COOKIE_DOMAIN=shazlo.store
# COOKIE_DOMAIN=

# Issuer claim of the tokens. In production this is the identity-api base URL,
# e.g. https://identity.shazlo.store
JWT_ISSUER=http://localhost:8001
# RS256 signing keys. Create one for local dev with `python -m identity_api.cli generate-key`
# (writes ./.keys/<kid>.pem, git-ignored), then point at it. The app refuses to start without a key.
# Production: mount the keys as secrets, never put them in the repo.
JWT_KEYS_DIR=.keys
JWT_SIGNING_KID=
# Alternative to the directory: a JSON object {"<kid>": "<PEM>"}. Keys that are only published
# (new key not yet signing, old key kept until its tokens expire) may be public PEMs.
# JWT_KEYS=
# Which roles may get a token for which service (JSON). A new service is added here.
# AUDIENCE_ROLES={"identity-api":["super_admin","vendor_reviewer"],"vendor-api":["super_admin","vendor_reviewer"]}
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30

# Argon2id cost; raising these rehashes existing passwords on next login.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12

# First super_admin, used only by `python -m identity_api.cli seed`. Prefer exporting these in the
# shell for a single run (or answer the prompt) rather than keeping the password in this file.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# Rate limits, "<limit>/<window seconds>". Defaults shown.
# RATE_LIMIT_LOGIN_IP=20/60
# RATE_LIMIT_LOGIN_EMAIL=5/900
# RATE_LIMIT_REFRESH_IP=60/60
# RATE_LIMIT_REFRESH_SESSION=20/60
# RATE_LIMIT_TOKEN_IP=120/60
# RATE_LIMIT_TOKEN_ADMIN=60/60
# RATE_LIMIT_CHANGE_PASSWORD_ADMIN=5/900
# Endpoints that answer 503 when Redis is down (the rest skip the limit).
# RATE_LIMIT_FAIL_CLOSED=login,change_password
# Required in prod, shared by every instance: `python -c "import secrets; print(secrets.token_hex(32))"`
# RATE_LIMIT_HMAC_KEY=
# Reverse proxies whose X-Forwarded-For is trusted (CIDR, comma separated). Empty: the header is ignored.
# TRUSTED_PROXIES=
